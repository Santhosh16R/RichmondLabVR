        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;\nflowchart LR\n    LMS[\&quot;LMS / SCORM Cloud&lt;br/&gt;Authenticated learner session\&quot;]\n    SCO[\&quot;SCORM Package&lt;br/&gt;bridge.html\&quot;]\n    SCORMJS[\&quot;scorm.js&lt;br/&gt;SCORM 2004 API wrapper\&quot;]\n    UNITYREST[\&quot;unity-rest.js&lt;br/&gt;Unity REST client\&quot;]\n    UNITYAUTH[\&quot;Unity Auth&lt;br/&gt;Token Exchange API\&quot;]\n    CLOUDCODE[\&quot;Unity Cloud Code&lt;br/&gt;Session scripts\&quot;]\n    SESSIONSTORE[\&quot;Unity Cloud Session State&lt;br/&gt;tokenId, bridgePlayerId, status, score\&quot;]\n    QUEST[\&quot;Meta Quest Device&lt;br/&gt;Unity VR App\&quot;]\n    QUESTBRIDGE[\&quot;QuestScormRestBridge.cs&lt;br/&gt;Quest REST client\&quot;]\n\n    LMS --&gt;|\&quot;Launch SCO\&quot;| SCO\n    SCO --&gt;|\&quot;Initialize / Get learner_id / learner_name\&quot;| SCORMJS\n    SCORMJS --&gt;|\&quot;SCORM API calls\&quot;| LMS\n\n    SCO --&gt;|\&quot;Request bearer token\&quot;| UNITYREST\n    UNITYREST --&gt;|\&quot;Basic auth token exchange\&quot;| UNITYAUTH\n    UNITYAUTH --&gt;|\&quot;Bearer token\&quot;| UNITYREST\n\n    UNITYREST --&gt;|\&quot;createSession(learnerId, learnerName, bridgePlayerId)\&quot;| CLOUDCODE\n    CLOUDCODE --&gt;|\&quot;Create tokenId + session\&quot;| SESSIONSTORE\n    SESSIONSTORE --&gt;|\&quot;tokenId + bridgePlayerId\&quot;| CLOUDCODE\n    CLOUDCODE --&gt;|\&quot;Session reference\&quot;| UNITYREST\n    UNITYREST --&gt;|\&quot;Display QR / manual code\&quot;| SCO\n\n    SCO --&gt;|\&quot;QR / tokenId / bridgePlayerId\&quot;| QUEST\n    QUEST --&gt;|\&quot;Start / complete training\&quot;| QUESTBRIDGE\n    QUESTBRIDGE --&gt;|\&quot;Token exchange / bearer token\&quot;| UNITYAUTH\n    QUESTBRIDGE --&gt;|\&quot;StartSession / CompleteSession\&quot;| CLOUDCODE\n    CLOUDCODE --&gt;|\&quot;Update status, score, passed, customData\&quot;| SESSIONSTORE\n\n    UNITYREST --&gt;|\&quot;Poll sessionstatus every few seconds\&
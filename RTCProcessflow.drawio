        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;\nsequenceDiagram\n    actor Learner\n    participant LMS as LMS / SCORM Cloud\n    participant Bridge as SCORM Bridge Page&lt;br/&gt;bridge.html\n    participant SCORM as SCORM API&lt;br/&gt;scorm.js\n    participant UnityAuth as Unity Auth API\n    participant CloudCode as Unity Cloud Code\n    participant Quest as Meta Quest App\n\n    Learner-&gt;&gt;LMS: Open assigned VR training\n    LMS-&gt;&gt;Bridge: Launch SCORM SCO\n\n    Bridge-&gt;&gt;SCORM: Initialize()\n    SCORM-&gt;&gt;LMS: Connect to LMS SCORM runtime\n    Bridge-&gt;&gt;SCORM: GetValue(cmi.learner_id, cmi.learner_name)\n    SCORM--&gt;&gt;Bridge: Learner identity\n\n    Bridge-&gt;&gt;UnityAuth: POST token-exchange&lt;br/&gt;Basic service auth\n    UnityAuth--&gt;&gt;Bridge: Bearer access token\n\n    Bridge-&gt;&gt;CloudCode: createSession&lt;br/&gt;learnerId, learnerName, bridgePlayerId\n    CloudCode--&gt;&gt;Bridge: tokenId, bridgePlayerId, playerId\n\n    Bridge--&gt;&gt;Learner: Show QR code and manual join code\n    Learner-&gt;&gt;Quest: Scan QR or enter tokenId / bridgePlayerId\n\n    Quest-&gt;&gt;UnityAuth: POST token-exchange\n    UnityAuth--&gt;&gt;Quest: Bearer access token\n\n    Quest-&gt;&gt;CloudCode: StartSession(tokenId, bridgePlayerId, playerId)\n    CloudCode--&gt;&gt;Quest: Session started\n\n    loop During VR activity\n        Bridge-&gt;&gt;CloudCode: sessionstatus(tokenId, bridgePlayerId)\n        CloudCode--&gt;&gt;Bridge: started / progress\n    end\n\n    Quest-&gt;&gt;CloudCode: CompleteSession(score, passed, customData)\n    CloudCode--&gt;&gt;Quest: Completion saved\n\n    Bridge-&gt;&gt;CloudCode: sessionstatus(tokenId, bridgePlayerId)\n    CloudCode--&gt;&gt;Bridge: completed, score, passed, customData\n\n    Bridge-&gt;&gt;SCORM: SetValue(cmi.score.raw)\n    Bridge-&gt;&gt;SCORM: SetValue(cmi.completion_status = completed)\n    Bridge-&gt;&gt;SCORM: SetValue(cmi.success_status = passed/failed)\n    Bridge-&gt;&gt;SCORM: SetValue(cmi.suspend_data)\n    Bridge-&gt;&gt;SCORM: Commit()\n    Bridge-&gt;&gt;SCORM: Terminate()\n\n    SCORM-&gt;&gt;LMS: Save learner result\n    LMS--&gt;&gt;Learner: Training marked complete&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="ad9NF0ljcMtA6QZSptTk-1">

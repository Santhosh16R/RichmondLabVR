<mxfile host="app.diagrams.net">
  <diagram name="Page-1" id="EU2BcgXi2vLiNA8n0-qT">
    <mxGraphModel dx="2828" dy="1486" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;\nsequenceDiagram\n  actor Learner\n  participant LMS as LMS / SCORM Cloud\n  participant Bridge as SCORM Bridge Page&lt;br/&gt;bridge.html\n  participant SCORM as SCORM API&lt;br/&gt;scorm.js\n  participant UnityAuth as Unity Auth API\n  participant CloudCode as Unity Cloud Code\n  participant CloudSave as Unity Cloud Save\n  participant Quest as Meta Quest App\n\n  Learner-&gt;&gt;LMS: Open assigned VR training\n  LMS-&gt;&gt;Bridge: Launch SCORM package&lt;br/&gt;Protocol: HTTPS&lt;br/&gt;Data: bridge.html, JS, CSS, manifest\n\n  Bridge-&gt;&gt;SCORM: Initialize(\&quot;\&quot;)\n  SCORM-&gt;&gt;LMS: Connect to SCORM runtime&lt;br/&gt;Protocol: SCORM 2004 JS API\n\n  Bridge-&gt;&gt;SCORM: GetValue(\&quot;cmi.learner_id\&quot;)&lt;br/&gt;GetValue(\&quot;cmi.learner_name\&quot;)\n  SCORM--&gt;&gt;Bridge: learnerId, learnerName\n\n  Bridge-&gt;&gt;SCORM: Set incomplete state\n  SCORM-&gt;&gt;LMS: SetValue completion_status=incomplete&lt;br/&gt;success_status=unknown&lt;br/&gt;Commit(\&quot;\&quot;)\n\n  Bridge-&gt;&gt;UnityAuth: Token exchange&lt;br/&gt;Protocol: HTTPS REST POST&lt;br/&gt;Auth: Basic credential&lt;br/&gt;Data: projectId, environmentId\n  UnityAuth--&gt;&gt;Bridge: accessToken\n\n  Bridge-&gt;&gt;Bridge: Generate sharedBridgeToken&lt;br/&gt;Data: tokenId / bridgePlayerId\n\n  Bridge-&gt;&gt;CloudCode: CreateSession&lt;br/&gt;Protocol: HTTPS REST POST&lt;br/&gt;Auth: Bearer accessToken&lt;br/&gt;Data: tokenId, bridgePlayerId,&lt;br/&gt;learnerId, learnerName\n\n  CloudCode-&gt;&gt;CloudSave: Store session record&lt;br/&gt;Data: status=waiting,&lt;br/&gt;tokenId, bridgePlayerId,&lt;br/&gt;learnerId, learnerName\n  CloudSave--&gt;&gt;CloudCode: Session saved\n  CloudCode--&gt;&gt;Bridge: tokenId, bridgePlayerId, status=waiting\n\n  Bridge--&gt;&gt;Learner: Show QR code and manual join code&lt;br/&gt;Data: { tokenId, bridgePlayerId }\n\n  Learner-&gt;&gt;Quest: Scan QR code / enter join code\n\n  Quest-&gt;&gt;UnityAuth: Unity Services sign-in&lt;br/&gt;Protocol: Unity SDK over HTTPS&lt;br/&gt;Auth: anonymous Quest player\n  UnityAuth--&gt;&gt;Quest: questPlayerId / auth context\n\n  Quest-&gt;&gt;CloudCode: StartSession&lt;br/&gt;Protocol: Unity SDK / HTTPS&lt;br/&gt;Data: tokenId, bridgePlayerId,&lt;br/&gt;questPlayerId context\n\n  CloudCode-&gt;&gt;CloudSave: Read session by tokenId + bridgePlayerId\n  CloudSave--&gt;&gt;CloudCode: Existing session\n  CloudCode-&gt;&gt;CloudSave: Update session&lt;br/&gt;Data: status=started,&lt;br/&gt;questPlayerId, startedAt\n  CloudCode--&gt;&gt;Quest: Session started\n\n  loop During VR activity\n    Bridge-&gt;&gt;CloudCode: SessionStatus poll every 3 seconds&lt;br/&gt;Protocol: HTTPS REST POST&lt;br/&gt;Data: tokenId, bridgePlayerId\n    CloudCode-&gt;&gt;CloudSave: Read session state\n    CloudSave--&gt;&gt;CloudCode: status, score, passed, customData\n    CloudCode--&gt;&gt;Bridge: status=waiting / started / completed\n  end\n\n  Quest-&gt;&gt;CloudCode: CompleteSession&lt;br/&gt;Protocol: Unity SDK / HTTPS&lt;br/&gt;Data: tokenId, bridgePlayerId,&lt;br/&gt;score, passed, customData\n\n  CloudCode-&gt;&gt;CloudSave: Validate questPlayerId\n  CloudCode-&gt;&gt;CloudSave: Update session&lt;br/&gt;Data: status=completed,&lt;br/&gt;score, passed, customData,&lt;br/&gt;completedAt\n  CloudCode--&gt;&gt;Quest: Completion saved\n\n  Bridge-&gt;&gt;CloudCode: SessionStatus poll\n  CloudCode-&gt;&gt;CloudSave: Read completed session\n  CloudSave--&gt;&gt;CloudCode: completed result\n  CloudCode--&gt;&gt;Bridge: status=completed,&lt;br/&gt;score, passed, customData\n\n  Bridge-&gt;&gt;SCORM: reportCompletion(result)\n  SCORM-&gt;&gt;LMS: SetValue(\&quot;cmi.score.raw\&quot;, score)\n  SCORM-&gt;&gt;LMS: SetValue(\&quot;cmi.score.scaled\&quot;, score / 100)\n  SCORM-&gt;&gt;LMS: SetValue(\&quot;cmi.completion_status\&quot;, \&quot;completed\&quot;)\n  SCORM-&gt;&gt;LMS: SetValue(\&quot;cmi.success_status\&quot;, passed / failed)\n  SCORM-&gt;&gt;LMS: SetValue(\&quot;cmi.session_time\&quot;, duration)\n  SCORM-&gt;&gt;LMS: SetValue(\&quot;cmi.suspend_data\&quot;, customData)\n\n  SCORM-&gt;&gt;LMS: Commit(\&quot;\&quot;)\n  SCORM-&gt;&gt;LMS: Terminate(\&quot;\&quot;)\n\n  LMS--&gt;&gt;Learner: Training marked complete\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="hsO7AXn-VEalSpvBAPNU-53">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=20;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
